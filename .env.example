# Personal AI Assistant Agent — environment variables.
# Copy to .env for local development. Never commit real values.
# Vars are added here as the milestone that introduces them is built
# (Engineering Guide Section 6); this file lists every var named in the
# guide so far.

# --- Issue #2: core settings ---
# optional, default: openai — "anthropic" or "openai"
# LLM_PROVIDER=
# required
OPENAI_API_KEY=
# optional, default: gpt-5.6-luna — uncomment and set to override
# LLM_MODEL=
# optional, default: gpt-5.6-luna — uncomment and set to override
# CLASSIFIER_MODEL=
# optional, default: gpt-5.6-luna — uncomment and set to override
# SUMMARIZER_MODEL=
# optional, default: sqlite+aiosqlite:///./agent.db — uncomment and set to override
# (production is always postgresql+asyncpg://... from the managed provider)
# DATABASE_URL=
MAX_TOKENS_PER_TURN=2048
WINDOW_HIGH_TOKENS=3000
WINDOW_LOW_TOKENS=1500
# optional, comma-separated, default: empty (no origins)
ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# --- Issue #11/#12: memory + token budgets ---
SUMMARY_MAX_TOKENS=
PINNED_FACTS_MAX=
CHAT_MAX_OUTPUT_TOKENS=
SESSION_TOKEN_BUDGET=

# --- Issue #10: orchestration loop ---
MAX_ITERATIONS=

# --- Issue #14/#15: RAG ---
EMBEDDINGS_MODEL=
RAG_TOP_K=
RAG_MIN_SCORE=

# --- Issue #17: Google Calendar auth ---
# Names to be finalized when Issue #17 is implemented (client id/secret/
# refresh token per the Engineering Guide).

# --- Issue #21: booking holds ---
HOLD_MINUTES=

# --- Issue #23: booking rate limits ---
BOOKING_ATTEMPTS_PER_SESSION=
# Per-IP-per-day booking cap: name to be finalized when Issue #23 is implemented.

# --- Issue #24: general rate limits ---
MESSAGES_PER_SESSION_PER_MIN=
MESSAGES_PER_IP_PER_MIN=

# --- Issue #26: retention ---
RETENTION_DAYS=
