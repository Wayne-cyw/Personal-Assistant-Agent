# Personal AI Assistant Agent — environment variables.
# Copy to .env for local development. Never commit real values.
# Vars are added here as the milestone that introduces them is built
# (Engineering Guide Section 6); this file lists every var named in the
# guide so far.

# --- Issue #2: core settings ---
# optional, default: openai — "anthropic" or "openai"
# LLM_PROVIDER=
# required
OPENAI_API_KEY=
# optional, default: gpt-5.6-luna — uncomment and set to override
# LLM_MODEL=
# optional, default: gpt-5.6-luna — uncomment and set to override
# CLASSIFIER_MODEL=
# optional, default: gpt-5.6-luna — uncomment and set to override
# SUMMARIZER_MODEL=
# optional, default: sqlite+aiosqlite:///./agent.db — uncomment and set to override
# (production is always postgresql+asyncpg://... from the managed provider)
# DATABASE_URL=
MAX_TOKENS_PER_TURN=2048
WINDOW_HIGH_TOKENS=3000
WINDOW_LOW_TOKENS=1500
# optional, comma-separated, default: empty (no origins)
ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# --- Issue #11/#12: memory + token budgets ---
# optional, default: 150 — uncomment and set to override
# SUMMARY_MAX_TOKENS=
# optional, default: 5 — uncomment and set to override
# PINNED_FACTS_MAX=
# optional, default: 3 — uncomment and set to override
# SUMMARY_AUDIT_INTERVAL=
# optional, default: false — refuse to start if a second worker is
# detected (WEB_CONCURRENCY > 1), instead of only logging a warning
# ENFORCE_SINGLE_WORKER=
# optional, default: unset — set by gunicorn/uvicorn process managers, not
# usually by hand; read here for the single-worker startup guard above
# WEB_CONCURRENCY=
# optional, default: 500 — uncomment and set to override
# CHAT_MAX_OUTPUT_TOKENS=
# optional, default: 50000 — uncomment and set to override
# SESSION_TOKEN_BUDGET=
# required — shown to visitors in the session-budget wrap-up message
OWNER_CONTACT_EMAIL=

# --- Issue #10: orchestration loop ---
# optional, default: 5 — uncomment and set to override
# MAX_ITERATIONS=

# --- Issue #14/#15: RAG ---
EMBEDDINGS_MODEL=
RAG_TOP_K=
RAG_MIN_SCORE=

# --- Issue #17: Google Calendar auth ---
# See README's "Google Calendar setup" section for how to obtain these.
# required
GOOGLE_CLIENT_ID=
# required
GOOGLE_CLIENT_SECRET=
# required — obtained by running scripts/gcal_auth.py once
GOOGLE_REFRESH_TOKEN=
# optional, default: primary — uncomment and set to override
# GOOGLE_CALENDAR_ID=

# --- Issue #21: booking holds ---
HOLD_MINUTES=

# --- Issue #23: booking rate limits ---
BOOKING_ATTEMPTS_PER_SESSION=
# Per-IP-per-day booking cap: name to be finalized when Issue #23 is implemented.

# --- Issue #24: general rate limits ---
MESSAGES_PER_SESSION_PER_MIN=
MESSAGES_PER_IP_PER_MIN=

# --- Issue #26: retention ---
RETENTION_DAYS=
